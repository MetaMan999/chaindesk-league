{
  "name": "chaindesk-league",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "test": "npm run test:contracts && npm run test:web",
    "test:contracts": "cd contracts && forge test -vvv",
    "test:web": "npm run test --workspace apps/web"
  },
  "engines": {
    "node": ">=20"
  }
}

