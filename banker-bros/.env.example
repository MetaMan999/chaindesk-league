# Never commit secrets. Use a dedicated testnet deployer.
DEPLOYER_PRIVATE_KEY=0x
TESTNET_RPC_URL=https://your-safe-evm-testnet-rpc.example
CHAIN_ID=11155111
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
GUARDIAN_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# Identity collection for this deployment. Use either Genesis 222 or the external
# StonkBroker collection; deploy a separate registry/router stack for each.
BROKER_IDENTITY_NFT=0x0000000000000000000000000000000000000000
SEASON_ID=1

# Optional Banker Bros: Founders collection
COLLECTION_ADDRESS=0x0000000000000000000000000000000000000000
COLLECTION_MINT_PRICE_WEI=20000000000000000
COLLECTION_PAYOUT=0x0000000000000000000000000000000000000000
COLLECTION_ROYALTY_RECEIVER=0x0000000000000000000000000000000000000000
COLLECTION_PLACEHOLDER_URI=ipfs://REPLACE_PLACEHOLDER_CID/hidden.json
COLLECTION_CONTRACT_URI=ipfs://REPLACE_CONTRACT_CID/contract.json
COLLECTION_SEED=replace-before-final-generation
ASSET_BASE_URI=ipfs://REPLACE_ASSET_CID

# Frontend (public)
VITE_CHAIN_ID=11155111
VITE_RPC_URL=https://your-safe-evm-testnet-rpc.example
VITE_WALLETCONNECT_PROJECT_ID=
VITE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_COLLECTION_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ACCOUNT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_DEAL_DESK_ADDRESS=0x0000000000000000000000000000000000000000
VITE_REALTIME_URL=http://127.0.0.1:8787

# Authenticated multiplayer service. Use a strong random secret outside local development.
REALTIME_HOST=127.0.0.1
REALTIME_PORT=8787
REALTIME_SESSION_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REALTIME_AUTH_DOMAIN=localhost
REALTIME_AUTH_URI=http://localhost:5173
REALTIME_REQUIRE_NFT_OWNERSHIP=false
REALTIME_RPC_URL=https://your-dedicated-safe-evm-testnet-rpc.example
REALTIME_TRUST_PROXY=false
REALTIME_DATA_FILE=./data/realtime-profiles.json

# Indexer
PONDER_RPC_URL=https://your-safe-evm-testnet-rpc.example
DATABASE_URL=postgresql://user:password@localhost:5432/banker_bros

# Optional API. Not required for protocol correctness.
API_SIGNING_KEY=
API_ALLOWED_ORIGINS=http://localhost:5173
