{
  "name": "banker-bros",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "build": "pnpm -r build",
    "dev:realtime": "pnpm --filter @banker-bros/realtime dev",
    "test:realtime": "pnpm --filter @banker-bros/realtime test",
    "typecheck": "pnpm -r typecheck",
    "test": "forge test -vvv",
    "collection:generate": "node scripts/generate-collection.mjs",
    "lint": "forge fmt --check && pnpm -r lint",
    "clean": "pnpm -r clean"
  }
}
